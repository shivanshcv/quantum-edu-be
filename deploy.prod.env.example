# Production settings for the Oracle Cloud single-VM deployment (backend + admin + MySQL + Caddy).
# Never commit deploy.prod.env (gitignored).
#
#   ./deploy/oracle/init-env.sh      # creates deploy.prod.env from this file with random secrets filled in
#   # then edit the REQUIRED values below
#   ./deploy.prod.sh --bootstrap     # first time only
#   ./deploy.prod.sh                 # every deploy
#
# This same file is copied to the VM as deploy/oracle/.env and read by docker compose.
# Use only letters and digits in passwords/secrets generated by hand (they are embedded in SQL and shell).

# --- VM access (REQUIRED) -----------------------------------------------------
VM_HOST=203.0.113.10
VM_USER=ubuntu
SSH_KEY=~/.ssh/oracle-quantum-edu.key

# --- Public URLs (REQUIRED) ---------------------------------------------------
# Free DuckDNS subdomains pointing at the VM's reserved public IP (no https://).
API_DOMAIN=quantum-edu-api.duckdns.org
ADMIN_DOMAIN=quantum-edu-admin.duckdns.org
# Vercel URL of the frontend (with https://, no trailing slash). Used for CORS and email links.
FRONTEND_URL=https://quantum-edu.vercel.app
# Optional extra comma-separated CORS origins (e.g. http://localhost:5173 for local FE against prod API).
EXTRA_CORS_ORIGINS=
# Let's Encrypt account email for HTTPS certificates.
ACME_EMAIL=you@gmail.com

# --- MySQL (generated) --------------------------------------------------------
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_APP_USER=quantum
MYSQL_APP_PASSWORD=__GENERATE__
# Load the demo catalogue + demo learners on first database initialisation.
SEED_SAMPLE_DATA=true

# --- Backend ------------------------------------------------------------------
JWT_SECRET=__GENERATE__

# Gmail SMTP: needs 2-Step Verification + an App Password (https://myaccount.google.com/apppasswords).
APP_EMAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD="abcd efgh ijkl mnop"
EMAIL_FROM=you@gmail.com

# Razorpay TEST mode keys (Dashboard -> Test Mode -> Account & Settings -> API Keys).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Must match the secret entered for the webhook https://<API_DOMAIN>/api/v1/cart/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=__GENERATE__

# --- Django admin -------------------------------------------------------------
DJANGO_SECRET_KEY=__GENERATE__
# Full-access superuser (created/updated on every admin container start).
DJANGO_SUPERUSER_USERNAME=shivansh
DJANGO_SUPERUSER_EMAIL=you@gmail.com
DJANGO_SUPERUSER_PASSWORD=__GENERATE__
# Optional view-only account you can share with clients/recruiters. Leave blank to skip.
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=__GENERATE__

# --- Cloudflare R2 media (REQUIRED for images, videos, PDFs and admin uploads) -
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=quantum-edu-media
# Public bucket URL (Settings -> Public Development URL), no trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# --- Backups ------------------------------------------------------------------
# Nightly mysqldump on the VM (kept 7 days). Optionally also copied to a PRIVATE R2 bucket
# (not the public media bucket). Create it in R2 without public access, or leave blank to skip.
BACKUP_R2_BUCKET=quantum-edu-backups
