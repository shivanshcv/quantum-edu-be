# Laptop-side settings for the Render + Aiven deployment (copy to deploy.render.env, never commit it).
# Used by:
#   ./deploy/render/init-db.sh            loads schema + sample data into Aiven MySQL
#   ./deploy/upload-media.sh       uploads demo media to R2 and sets bucket CORS
# The services themselves are configured in the Render dashboard (see render.yaml).

# --- Aiven MySQL (Aiven console -> your service -> Overview -> Connection information) ---
MYSQL_HOST=mysql-xxxxxxxx-yourproject.l.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=

# --- Frontend (Vercel URL, with https://, no trailing slash) ---
FRONTEND_URL=https://quantum-edu.vercel.app
# Optional extra comma-separated CORS origins for the R2 bucket.
EXTRA_CORS_ORIGINS=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quantum-edu-media
# Public bucket URL, no trailing slash. Sample-data media URLs become ${R2_PUBLIC_URL}/seed/...
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
